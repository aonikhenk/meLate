rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Cada teléfono solo escribe su propio registro.
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
    // Códigos: se pueden consultar para emparejar; solo el dueño los crea.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth.uid == request.resource.data.uid;
    }
    // Latidos: lo envía el emisor; lo lee/borra el receptor.
    match /beats/{id} {
      allow create: if request.auth.uid == request.resource.data.from;
      allow read, update, delete: if request.auth.uid == resource.data.to;
    }
  }
}
